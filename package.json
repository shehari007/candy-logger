{
  "name": "candy-logger",
  "version": "2.2.0",
  "description": "An in-page log panel for browser apps. Captures console output into a searchable table with safe serialization of circular objects, Errors, Map, Set and BigInt. Zero dependencies, about 5 kB gzipped core, panel loaded on demand.",
  "keywords": [
    "logger",
    "console",
    "browser",
    "debug",
    "logging",
    "devtools",
    "console-panel",
    "log-viewer",
    "overlay",
    "mobile-debug",
    "error-tracking",
    "csp",
    "typescript",
    "zero-dependency",
    "react",
    "vue",
    "angular",
    "svelte"
  ],
  "homepage": "https://candy-logger.msyb.dev",
  "bugs": {
    "url": "https://github.com/shehari007/candy-logger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shehari007/candy-logger.git"
  },
  "license": "MIT",
  "author": {
    "name": "Muhammad Sheharyar Butt",
    "url": "https://github.com/shehari007"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/candy-logger.global.js",
  "jsdelivr": "./dist/candy-logger.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./global": "./dist/candy-logger.global.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && npx --yes serve -l 4321 .",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  }
}
